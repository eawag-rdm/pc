#####################################################################################
# README
# ------
# Sections are function names
#
# Settings are contained in lists each list entry represents one function call.
#
# Within setting function arguments are defined.
#
# For each function (section) a whitelist and a blacklist can be defined.
#
# REGEX USAGE RULES:
# ==================
# 
# REGEX PATTERNS ARE ALLOWED IN:
# - blacklist: File paths that match these patterns are skipped
# - whitelist: Only file paths that match these patterns are checked
#
# Examples of valid regex patterns for blacklist/whitelist:
# - "test\.txt"           (matches test.txt exactly)
# - ".*\.log$"            (matches any .log file)
# - "temp.*"              (matches files starting with "temp")
# - "test[0-9]+\.txt"     (matches test1.txt, test2.txt, etc.)
#
# REGEX PATTERNS ARE NOT ALLOWED IN:
# - keywords: These are literal strings only, matched case-insensitively
# - disallowed_names: These are literal strings only
#
# Examples of valid literal strings for keywords:
# - "password"            (matches "password", "Password", "PASSWORD")
# - "api_key"             (matches "api_key", "API_KEY", etc.)
# - "/Users/"             (matches the literal string "/Users/")
# - "Q:"                  (matches the literal string "Q:")
#
# DO NOT USE regex patterns in keywords like:
# - "pass.*"              (will look for literal "pass.*" not regex)
# - "[Pp]assword"         (will look for literal "[Pp]assword")
#
#####################################################################################

[general]
# Maximum size for individual files in archives (bytes) - 10MB
maxArchiveFileSize = 10485760
# Maximum total memory for archive processing (bytes) - 500MB
maxTotalArchiveMemory = 536870912
# Maximum size for files that read content (like IsFreeOfKeywords) (bytes) - 20MB
maxContentScanFileSize = 20971520
# Introductory text shown at the top of the summary (set to "" to disable)
summaryIntroText = "We have analyzed your data package and found a few issues. Please address them and get back to us once you're done. Then, we can continue with the publication process. Feel free to get back to us, if something is unclear."
# Number of issues to show before truncating with "... and X more" (default: 5)
summaryMaxIssuesBeforeTruncation = 5
# Minimum group size required to trigger truncation (default: 3)
summaryMinGroupSizeForTruncation = 3

[server]
# Settings for the pc-server HTTP API. The server takes NO command-line flags;
# every setting (including the listen address) lives here. The CKAN URL is NOT
# configured here — it is read from [collector.CkanCollector.attrs] url.
# Address the server listens on (host:port)
listenAddress      = "127.0.0.1:8080"
# Whether to trust proxy-set client IP headers (X-Real-IP)
trustProxyHeaders  = true
# CIDRs allowed to set X-Real-IP (only these connections are trusted as proxies)
trustedProxies     = ["127.0.0.1/32"]
# CORS allow-list of origin URLs
allowedOrigins     = ["https://frontend.example.org"]
# Per-IP hourly request budget
perIPRequestsPerHour  = 4
# Global hourly request budget
globalRequestsPerHour = 20
# Additional headroom applied to the budgets (+50%)
burstFactor           = 0.5
# Seconds a request waits for the single analysis gate before returning service_busy (503)
analysisBusyWaitSeconds = 2
# Limiter memory bound (max tracked rate keys)
maxTrackedRateKeys    = 10000
# Contact suffix shown in error envelopes
contactMessage        = "If you can't resolve this yourself, please contact rdm@eawag.ch."
# Whether to log the client IP (personal data; documented purpose = abuse/security)
logClientIP           = true
# Hard upper bound for a WHOLE analysis request (CKAN call + all checks), in seconds
requestTimeoutSeconds = 300
# Upper bound for the single CKAN package_show call, in seconds. A CKAN that
# cannot answer a metadata GET within this window is reported as unavailable
# (ckan_unavailable) instead of eating the analysis time budget. Must be <=
# requestTimeoutSeconds.
ckanRequestTimeoutSeconds = 10
# Per-package result cache (SERVER-ONLY; the CLI never caches). When set, a
# successful analysis is stored as one JSON file per package under this
# directory and served again while the package's CKAN metadata_modified is
# unchanged — repeat requests then cost one package_show round-trip instead of
# a full file scan. Empty disables caching. In Docker this must point into a
# persistent volume (see docker-compose.yml).
resultCacheDir        = ""
# Max cached packages; beyond this the oldest entries are evicted
resultCacheMaxEntries = 500
# Max age of a cache entry in hours (safety net for storage-mount edits CKAN
# never sees); 0 disables the age limit
resultCacheMaxAgeHours = 24

# [server.smtp] — optional admin-alert relay (a sub-section of [server], so it
# MUST come after the [server] keys above). When enabled, the server emails this
# list on a SERVER-FAULT response: internal_error, a recovered panic, or
# resource_unreadable. Plain relay, NO authentication. Every fault is reported
# (there is no rate cap). Leave host empty (or omit this whole block) to DISABLE
# alerts. The mail carries no secrets — only the request_id, code, method, path
# and package_id; the full cause/stack stays in the logs, keyed by request_id.
[server.smtp]
# SMTP relay host; empty disables admin alerts
host = ""
# SMTP relay port
port = 25
# From / envelope-sender address for alert mails
from = "pc-server@eawag.ch"
# Admin recipient addresses (at least one required when host is set)
to = ["rdm@eawag.ch"]

[operation.main]
collector = "LocalCollector"

[test.HasOnlyASCII]
# Checking for Non-ASCII characters in folder and file names.
blacklist = []
whitelist = []

[test.HasNoWhiteSpace]
# Checking for white spaces in folder and file names.
blacklist = []
whitelist = []

[test.IsFreeOfKeywords]
# Checking file contents for sensitive information
# blacklist/whitelist: Use regex patterns to include/exclude files by path
blacklist = []
whitelist = []
# keywords: Use literal strings only (case-insensitive matching)
keywordArguments = [
    { keywords = ["password", "secret", "key", "token", "api", "credential", "auth"], info = "Security credentials detected" },
    { keywords = ["id_rsa", "id_ed25519", "BEGIN PRIVATE KEY", "BEGIN RSA PRIVATE KEY"], info = "Private key detected" },
    { keywords = ["jwt", "bearer", "oauth", "client_secret"], info = "Authentication token detected" },
    { keywords = ["database", "db_password", "connection_string"], info = "Database credentials detected" },
    { keywords = ["/home/", "/Users/", "C:\\Users\\", "Q:"], info = "Hardcoded file paths detected" },
    { keywords = ["admin", "root", "superuser"], info = "Administrative accounts detected" }
]

[test.HasFileNameSpecialChars]
# Checking for invalid/special characters in file names
# blacklist/whitelist: Use regex patterns to include/exclude files by path
blacklist = []
whitelist = []

[test.IsFileNameTooLong]
# Checking if file names are longer than 64 characters
# blacklist/whitelist: Use regex patterns to include/exclude files by path
blacklist = []
whitelist = []

[test.IsValidName]
# Checking for invalid files and folders
# blacklist/whitelist: Use regex patterns to include/exclude files by path
blacklist = []
whitelist = []
# disallowed_names: Use literal strings only (exact filename matching)
keywordArguments = [
    { disallowed_names = [ 
        ".Rhistory", ".RData",
        ".Rapp.history", ".Ruserdata", 
        ".Rbuildignore", "__pycache__", ".vscode", 
        ".ipynb_checkpoints", "venv", ".idea", ".egg-info", 
        ".pytest_cache", ".pyc", ".tox", ".python_version", 
        ".coverage", ".benchmark", ".doc", ".xls", ".DS_Store"
    ]}
]

[collector.CkanCollector]
attrs = {url = "https://example.com", token = "", verify = true, ckan_storage_path = "/nfsmount/ckan/default"}

[collector.LocalCollector]
attrs = {includeFolders = false}
