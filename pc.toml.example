#####################################################################################
# README
# ------
# Checks are configured as rules: each [[rule]] is one named instance of a
# check with its own file selector and its own [rule.params].
#
#   name       unique rule name (shown in diagnostics)
#   check      check to run, with the scopes it serves (a rule may name a subset):
#              HasOnlyASCII             file, archive-file-list
#              HasNoWhiteSpace          archive-file-list
#              IsFreeOfKeywords         file, archive-member
#              IsValidName              file, archive-file-list
#              HasFileNameSpecialChars  file, archive-file-list
#              IsFileNameTooLong        file, archive-file-list
#              IsFreeOfSecrets          repository
#              HasReadme                repository
#              ReadMeContainsTOC        repository
#   scope      dispatch phases, default = the check's own
#              (file, archive-file-list, archive-member, repository)
#   subject    what patterns match: "name" | "path"; per scope:
#              file: name = the file's name (default), path = its relative path
#              archive-file-list: name = member basename (default), path = member path
#              archive-member: selector addresses members, default subject path
#              repository: path = the file's relative path (default)
#              at archive-file-list IsFileNameTooLong measures the member's
#              base name, the character checks read the whole member path
#   include    regex patterns; only matching files are checked
#   exclude    regex patterns; matching files are skipped (exclude wins)
#   ignoreCase true = case-insensitive patterns (default false)
#   enabled    false = the rule does not run (default true)
#
# Patterns are RE2 regexes, matched unanchored and case-sensitively unless
# ignoreCase is set. keywords/disallowed_names/readme_names are literal
# strings, never regexes. A repeated [[rule.params]] block declares several
# parameter sets on one rule. Most checks without a rule run with defaults (not
# IsFreeOfSecrets: its synthesized rule is disabled); IsFreeOfKeywords,
# IsValidName and HasReadme must be declared. One rule per parameter set: two
# rules of one check binding the same parameters where they gate the same
# strings, under the same ignoreCase, are refused.
#####################################################################################

[general]
# Maximum size for individual files in archives (bytes) - 10MB
maxArchiveFileSize = 10485760
# Maximum total memory for archive processing (bytes) - 512MB
maxTotalArchiveMemory = 536870912
# Max members per archive: content scan counts unpack candidates, name walk counts all entries (0 = default 1000, not unlimited)
maxArchiveMemberCount = 1000
# Page ceiling per PDF; a longer PDF is skipped whole (0 = default 10, not unlimited)
maxPDFPages = 10
# Max PDF size (bytes) - 1MB; a larger PDF is not read at all (0 = default, not unlimited)
maxPDFFileSize = 1048576
# Maximum size for files that read content (like IsFreeOfKeywords) (bytes) - 20MB
maxContentScanFileSize = 20971520
# CPU cores this process may use (0 = default 4); see usage.md
maxCores = 4
# Introductory text shown at the top of the summary (set to "" to disable)
summaryIntroText = "We have analyzed your data package and found a few issues. Please address them and get back to us once you're done. Then, we can continue with the publication process. Feel free to get back to us, if something is unclear."
# Number of issues to show before truncating with "... and X more" (default: 5)
summaryMaxIssuesBeforeTruncation = 5
# Minimum group size required to trigger truncation (default: 3)
summaryMinGroupSizeForTruncation = 3

[server]
# Settings for the pc-server HTTP API. No setting is overridable by a flag
# (-config names this file, -help prints usage); everything, the listen address
# included, lives here. The CKAN URL is NOT configured here - it is read from
# [collector.CkanCollector.attrs] url.
# Address the server listens on (host:port)
listenAddress      = "127.0.0.1:8080"
# Whether to trust proxy-set client IP headers (X-Real-IP)
trustProxyHeaders  = true
# CIDRs allowed to set X-Real-IP (only these connections are trusted as proxies)
trustedProxies     = ["127.0.0.1/32"]
# CORS allow-list of origin URLs
allowedOrigins     = ["https://frontend.example.org"]
# Per-IP hourly request budget
perIPRequestsPerHour  = 4
# Global hourly request budget
globalRequestsPerHour = 20
# Cache hits are refunded and counted against budgets × this factor; 0 disables the refund
cachedRequestLimitFactor = 100
# Additional headroom applied to the budgets (+50%)
burstFactor           = 0.5
# Seconds a request waits for the single analysis gate before returning service_busy (503)
analysisBusyWaitSeconds = 2
# Limiter memory bound (max tracked rate keys)
maxTrackedRateKeys    = 10000
# Contact suffix shown in error envelopes
contactMessage        = "If you can't resolve this yourself, please contact rdm@eawag.ch."
# Whether to log the client IP (personal data; documented purpose = abuse/security)
logClientIP           = true
# Hard upper bound for a WHOLE analysis request (CKAN call + all checks), in seconds
requestTimeoutSeconds = 300
# Upper bound for the single CKAN package_show call, in seconds. A CKAN that
# cannot answer a metadata GET within this window is reported as unavailable
# (ckan_unavailable) instead of eating the analysis time budget. Must be <=
# requestTimeoutSeconds.
ckanRequestTimeoutSeconds = 10
# Result cache dir (server-only, absolute path); empty disables. Its reserved "entries" subdir is wiped at every start (a failed wipe aborts the boot); one server per dir.
resultCacheDir        = ""
# Max cached packages; beyond this the oldest entries are evicted
resultCacheMaxEntries = 500
# Max age of a cache entry in hours; 0 (the default) disables the age limit -
# CKAN's metadata_modified alone decides freshness. Set only if files on the
# storage mount can change behind CKAN's back.
resultCacheMaxAgeHours = 0

# [server.smtp] - optional admin-alert relay (a sub-section of [server], so it
# MUST come after the [server] keys above). When enabled, the server emails this
# list on a SERVER-FAULT response: internal_error, a recovered panic, or
# resource_unreadable. Plain relay, NO authentication. Every fault alerts, except
# resource_unreadable: at most one per package per hour, the swallowed count
# riding the next alert. Leave host empty (or omit this whole block) to DISABLE
# alerts. The mail carries no secrets - only the request_id, code, method, path
# and package_id; the full cause/stack stays in the logs, keyed by request_id.
[server.smtp]
# SMTP relay host; empty disables admin alerts
host = ""
# SMTP relay port
port = 25
# From / envelope-sender address for alert mails
from = "pc-server@eawag.ch"
# Admin recipient addresses (at least one required when host is set)
to = ["rdm@eawag.ch"]

[operation.main]
collector = "LocalCollector"

[[rule]]
# Non-ASCII characters in folder and file names
name  = "ascii-names"
check = "HasOnlyASCII"

[[rule]]
# White spaces in archive member names
name  = "no-whitespace"
check = "HasNoWhiteSpace"

[[rule]]
# Sensitive keywords in file contents (keywords = literal strings, case-insensitive);
# secrets (credentials, keys, tokens) are found by the IsFreeOfSecrets rule instead.
# One rule, several [[rule.params]] groups: each group reports with its own info.
name  = "sensitive-content"
check = "IsFreeOfKeywords"
  [[rule.params]]
  keywords = ["/home/", "/Users/", "C:\\Users\\", "Q:"]
  info     = "Hardcoded file paths detected"
  [[rule.params]]
  keywords = ["admin", "root", "superuser"]
  info     = "Administrative accounts detected"

[[rule]]
# Secret scan of file contents via the bundled betterleaks binary.
# Dormant for now: scan too slow; code kept, flip enabled = true to reactivate.
name    = "secret-scan"
check   = "IsFreeOfSecrets"
enabled = false
  [rule.params]
  # scanner executable (name in PATH or absolute path)
  binary = "betterleaks"
  # whole-scan cap in seconds (must not exceed [server] requestTimeoutSeconds)
  timeoutSeconds = 120
  # CPU cores the scanner may use; capped by [general] maxCores (the lower wins)
  maxProcs = 4

[[rule]]
# Invalid/special characters in file names
name  = "no-special-chars"
check = "HasFileNameSpecialChars"

[[rule]]
# File names longer than 64 characters
name  = "name-length"
check = "IsFileNameTooLong"

[[rule]]
# The repository readme must be present; which filenames count is the check's
# built-in default list (readme_names overrides it). ReadMeContainsTOC reads this rule.
name  = "readme-present"
check = "HasReadme"

[[rule]]
# Disallowed file/folder names (literal strings, exact or suffix match)
name  = "no-junk-files"
check = "IsValidName"
  [rule.params]
  disallowed_names = [
      ".Rhistory", ".RData",
      ".Rapp.history", ".Ruserdata",
      ".Rbuildignore", "__pycache__", ".vscode",
      ".ipynb_checkpoints", "venv", ".idea", ".egg-info",
      ".pytest_cache", ".pyc", ".tox", ".python_version",
      ".coverage", ".benchmark", ".doc", ".xls", ".DS_Store"
  ]

[collector.CkanCollector]
attrs = {url = "https://example.com", token = "", verify = true, ckan_storage_path = "/nfsmount/ckan/default"}

[collector.LocalCollector]
# includeFolders: legacy switch, true = unlimited recursion; maxFolderDepth (0 = top level, N = descend N levels) wins over it
# maxFileCount: stop collecting after N entries (0 = no cap)
attrs = {includeFolders = false, maxFolderDepth = 0, maxFileCount = 10000}
